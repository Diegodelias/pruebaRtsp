# Copiar este archivo como .env y completar/ajustar si fuera necesario.
# No versionar .env: contiene credenciales de la cámara.

CAM_USER=usuario
CAM_PASS=cambiar
CAM_HOST=host.ejemplo.com:554
PORT=3100
TZ_OFFSET_MIN=-180

# Si ffmpeg/ffprobe no están en PATH, indicar sus rutas completas.
# En Windows, usar barras normales o rutas escapadas:
# FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE=C:/ffmpeg/bin/ffprobe.exe
